# Supabase: optional storage for quote requests in a quote_requests table.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Uses anon key with Row Level Security enabled — ensure an INSERT policy
# exists for the anon role on the quote_requests table.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Resend: required in production to email Djamila automatically after a quote request.
RESEND_API_KEY=re_your_api_key
RESEND_FROM="Fée du Ménage <devis@your-domain.fr>"
