# Supabase: optional storage for quote requests in a quote_requests table.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend: required in production to email Djamila automatically after a quote request.
RESEND_API_KEY=re_your_api_key
RESEND_FROM="Fée du Ménage <devis@your-domain.fr>"
# Supabase: used by app/api/devis to store quote requests in a quote_requests table.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend: used by app/api/devis to email Djamila automatically after a request.
RESEND_API_KEY=re_your_api_key
RESEND_FROM="Fée du Ménage <devis@your-domain.fr>"

# Admin chat interface (see /admin/chat)
ANTHROPIC_API_KEY=sk-ant-your-api-key
ADMIN_PASSWORD=your-secure-password
